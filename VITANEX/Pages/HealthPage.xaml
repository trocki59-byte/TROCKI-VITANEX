<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VITANEX.Pages.HealthPage"
             Title="Sağlık">

    <ScrollView>
        <Grid x:Name="Host" Padding="16" ColumnSpacing="12">
            <VerticalStackLayout x:Name="ColA" Spacing="12">

                <!-- BUGÜN -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Bugün" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" x:Name="ScoreLabel" FontAttributes="Bold"
                                   TextColor="{StaticResource Green}" FontSize="16" />
                        </Grid>
                        <Label x:Name="WaterLabel" FontSize="14" />
                        <ProgressBar x:Name="WaterBar" ProgressColor="{StaticResource Accent}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Text="💧 +200" Style="{StaticResource SecondaryButton}" Clicked="OnWater200" />
                            <Button Grid.Column="1" Text="💧 +500" Style="{StaticResource SecondaryButton}" Clicked="OnWater500" />
                            <Button Grid.Column="2" Text="↺ Geri al" Style="{StaticResource SecondaryButton}" Clicked="OnWaterUndo" />
                        </Grid>
                        <Label x:Name="SleepExLabel" Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- SON ÖLÇÜMLER -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Son Ölçümler" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="VitalsGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="8" RowSpacing="8" />
                        <Button Text="+ Sağlık Kaydı Ekle" Clicked="OnAddRecord" />
                    </VerticalStackLayout>
                </Border>

                <!-- KİLO GRAFİĞİ -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Kilo Değişimi (son 30 kayıt)" Style="{StaticResource SectionTitle}" />
                        <GraphicsView x:Name="WeightChart" HeightRequest="190" />
                    </VerticalStackLayout>
                </Border>

                <!-- TANSİYON / NABIZ GRAFİĞİ -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Büyük Tansiyon (son 30 kayıt)" Style="{StaticResource SectionTitle}" />
                        <GraphicsView x:Name="BpChart" HeightRequest="190" />
                    </VerticalStackLayout>
                </Border>

                <!-- İLAÇLAR -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="💊 İlaçlarım" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Text="+ İlaç" Style="{StaticResource SecondaryButton}" Clicked="OnAddMedication" />
                        </Grid>
                        <VerticalStackLayout x:Name="MedList" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMedicationTapped" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                            <Label Text="{Binding Info}" Style="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding StateText}" TextColor="{Binding StateColor}"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label x:Name="NoMeds" Text="Henüz ilaç eklenmedi." Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Border>

                <!-- KAYITLAR -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Kayıt Geçmişi" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout x:Name="RecordList" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="0,8" Spacing="2">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRecordTapped" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding DateText}" FontAttributes="Bold" FontSize="13"
                                               TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding Summary}" FontSize="14" />
                                        <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" Style="{StaticResource Muted}" />
                                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" Margin="0,6,0,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label x:Name="NoRecords" Text="Henüz sağlık kaydı yok." Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
            <VerticalStackLayout x:Name="ColB" Grid.Column="1" Spacing="12" IsVisible="False" />
        </Grid>
    </ScrollView>
</ContentPage>
