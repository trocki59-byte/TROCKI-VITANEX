<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VITANEX.Pages.ModuleEntryPage">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="720">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Tür" Style="{StaticResource FieldLabel}" />
                    <Picker x:Name="KindField" Title="Tür seçin" />

                    <Label Text="Başlık" Style="{StaticResource FieldLabel}" />
                    <Entry x:Name="TitleField" Placeholder="Başlık" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="Tarih / saat ekle" Style="{StaticResource FieldLabel}" VerticalOptions="Center" Margin="0" />
                        <Switch Grid.Column="1" x:Name="DateSwitch" Toggled="OnDateToggled" OnColor="{StaticResource Accent}" />
                    </Grid>
                    <Grid x:Name="DateRow" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="False">
                        <DatePicker x:Name="DateField" />
                        <TimePicker Grid.Column="1" x:Name="TimeField" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="İlerleme" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Label Grid.Column="1" x:Name="ProgressLabel" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    </Grid>
                    <Slider x:Name="ProgressField" Minimum="0" Maximum="100" ValueChanged="OnProgressChanged"
                            MinimumTrackColor="{StaticResource Accent}" ThumbColor="{StaticResource Primary}" />

                    <Label Text="Durum" Style="{StaticResource FieldLabel}" />
                    <Picker x:Name="StatusField" Title="Durum" />

                    <Label Text="Not" Style="{StaticResource FieldLabel}" />
                    <Editor x:Name="NoteField" AutoSize="TextChanges" Placeholder="Ayrıntılar, yazar, kurs linki, yer, kişiler…" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Kaydet" Clicked="OnSave" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
