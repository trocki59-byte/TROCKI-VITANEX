<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VITANEX.Pages.TasksPage"
             Title="Görevler">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,90" Spacing="12" MaximumWidthRequest="960">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Bugünün İlerlemesi" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" x:Name="TodayLabel" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource Orange}" />
                        </Grid>
                        <ProgressBar x:Name="TodayBar" ProgressColor="{StaticResource Orange}" />
                        <Label x:Name="CountsLabel" Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="Chips" Spacing="8">
                        <Button Text="Bugün" ClassId="today" Style="{StaticResource ChipButton}" Clicked="OnFilter" />
                        <Button Text="Yaklaşan" ClassId="upcoming" Style="{StaticResource ChipButton}" Clicked="OnFilter" />
                        <Button Text="Bekliyor" ClassId="0" Style="{StaticResource ChipButton}" Clicked="OnFilter" />
                        <Button Text="Devam Ediyor" ClassId="1" Style="{StaticResource ChipButton}" Clicked="OnFilter" />
                        <Button Text="Tamamlandı" ClassId="2" Style="{StaticResource ChipButton}" Clicked="OnFilter" />
                        <Button Text="Tümü" ClassId="all" Style="{StaticResource ChipButton}" Clicked="OnFilter" />
                    </HorizontalStackLayout>
                </ScrollView>

                <Border Style="{StaticResource Card}" Padding="14,6">
                    <VerticalStackLayout>
                        <VerticalStackLayout x:Name="TaskList">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="36,*,Auto" Padding="0,10" ColumnSpacing="10">
                                        <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 13"
                                                StrokeThickness="2" Stroke="{Binding StatusBrush}" BackgroundColor="{DynamicResource CardBg}"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnToggleTapped" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding StatusIcon}" TextColor="{Binding StatusColor}" FontAttributes="Bold"
                                                   FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTaskTapped" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                                                   TextDecorations="{Binding TitleDecoration}" />
                                            <Label Text="{Binding WhenText}" Style="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding PriorityText}" TextColor="{Binding PriorityColor}"
                                                   FontSize="12" FontAttributes="Bold" HorizontalOptions="End" />
                                            <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}"
                                                   FontSize="11" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label x:Name="EmptyLabel" Text="Bu filtrede görev yok." Style="{StaticResource Muted}" Margin="0,10" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button Text="+" FontSize="32" Padding="0" WidthRequest="62" HeightRequest="62" CornerRadius="31"
                BackgroundColor="{StaticResource Accent}" HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,20,20" Clicked="OnAdd" />
    </Grid>
</ContentPage>
